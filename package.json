{
  "name": "yamu-deck",
  "version": "0.3.4",
  "description": "Yandex Music client for Steam Deck",
  "main": "electron/main.cjs",
  "author": "Yamu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:ui": "electron scripts/smoke.cjs",
    "test:features": "electron scripts/features-smoke.cjs",
    "test:mpris": "node scripts/mpris-integration.cjs",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.yamu.deck",
    "productName": "Yamu",
    "files": [
      "electron/**",
      "ui/**",
      "package.json"
    ],
    "linux": {
      "extraFiles": [
        {
          "from": "scripts/start-yamu.sh",
          "to": "start-yamu.sh"
        },
        {
          "from": "scripts/start-yamu-gamemode.sh",
          "to": "start-yamu-gamemode.sh"
        },
        {
          "from": "scripts/diagnose-yamu-gamemode.sh",
          "to": "diagnose-yamu-gamemode.sh"
        }
      ],
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "executableName": "yamu",
      "desktop": {
        "entry": {
          "Name": "Yamu",
          "Comment": "Yandex Music for Steam Deck"
        }
      }
    }
  },
  "dependencies": {
    "@jellybrick/dbus-next": "0.11.4"
  }
}
